{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.stock-analysis/schema/raw-manifest.schema.json",
  "title": "Stock Analysis Raw Research Manifest",
  "type": "object",
  "required": ["authority", "files"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "collection": {
      "type": "string",
      "minLength": 1
    },
    "company": {
      "type": "string"
    },
    "ticker": {
      "type": "string"
    },
    "cik": {
      "type": "string",
      "pattern": "^[0-9]{10}$"
    },
    "fiscal_period": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "accounting_basis": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      ]
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "release_date": {
      "type": "string",
      "format": "date"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "event_page": {
      "type": "string",
      "format": "uri"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "type", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "accounting_basis": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_tier": {
            "enum": ["official", "third_party", "unverified"]
          },
          "source_url": {
            "type": ["string", "null"],
            "format": "uri"
          },
          "source_original_path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "imported_at": {
            "type": "string",
            "format": "date-time"
          },
          "period_confidence": {
            "enum": ["high", "medium", "low"]
          },
          "source_authority": {
            "type": "string"
          },
          "mime_type": {
            "type": "string"
          },
          "filing_form": {
            "enum": ["8-K", "10-Q", "10-K", "6-K", "20-F"]
          },
          "accession_number": {
            "type": "string",
            "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"
          },
          "filing_date": {
            "type": "string",
            "format": "date"
          },
          "period_end": {
            "type": "string",
            "format": "date"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "validation_status": {
            "enum": ["verified", "failed", "pending"]
          }
        },
        "additionalProperties": true
      }
    },
    "pending_sources": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "unavailable_sources": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "validation_status": {
      "enum": ["complete", "partial", "failed"]
    }
  },
  "additionalProperties": true
}
